[Unit]
Description=Inventario de herramientas
After=network.target

[Service]
User=inventario
WorkingDirectory=/opt/inventario
EnvironmentFile=/etc/inventario.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Endurecimiento: solo puede escribir sus datos y las fotos
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/inventario/data /opt/inventario/uploads

[Install]
WantedBy=multi-user.target
