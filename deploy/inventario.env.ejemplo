# Copiar a /etc/inventario.env (chmod 600) y rellenar
PORT=3000
PUBLIC_URL=https://inventario.tudominio.es
DB_FILE=/opt/inventario/data/inventario.db
# Servidor común: sin datos ni accesos de demostración
NO_SEED=1
DEMO=0
# Detrás de Caddy: tomar la IP real para el límite de intentos de login
TRUST_PROXY=1
# Clave para dar de alta empresas (mínimo 16 caracteres). Generar con: openssl rand -hex 24
CLAVE_ALTA=
